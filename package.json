    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cspell": "^10.4.0",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pagefind": "^1.5.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
