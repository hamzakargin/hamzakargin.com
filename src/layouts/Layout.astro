---
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { defaultLocale, intlLocales, locales } from "@/i18n/ui";
import { cleanPath, getLocale, localizePath, stripLocale, useTranslations } from "@/i18n/utils";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonicalPath?: string;
  alternates?: boolean;
  noindex?: boolean;
}

const locale = getLocale(Astro);
const t = useTranslations(locale);
const {
  title = "Hamza Kargin",
  description = t("meta.description"),
  image,
  type = "website",
  canonicalPath,
  alternates = true,
  noindex = false,
} = Astro.props;
const pathname = cleanPath(Astro.url);
const basePath = stripLocale(pathname) || "/";
const canonical = new URL(canonicalPath ?? pathname, Astro.site);
const alternateLinks = alternates && !noindex
  ? [
      ...locales.map((code) => ({
        hreflang: code,
        href: new URL(localizePath(basePath, code), Astro.site).href,
      })),
      { hreflang: "x-default", href: new URL(localizePath(basePath, defaultLocale), Astro.site).href },
    ]
  : [];
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <meta property="og:locale" content={intlLocales[locale].replace("-", "_")} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Hamza Kargin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", stored ? stored === "dark" : prefersDark);
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-30 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-sm focus:ring-2 focus:ring-ring"
    >
      {t("a11y.skip")}
    </a>
    <Header />
    <div class="px-4 md:px-6">
      <main id="main" class="mx-auto min-h-[calc(100dvh-3.5rem)] max-w-5xl border-x border-border">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
