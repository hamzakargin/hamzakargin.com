---
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Section from "@/components/layout/Section.astro";
import Layout from "@/layouts/Layout.astro";
import { ogImagePath } from "@/lib/og";
import PostList from "@/components/blog/PostList.astro";
import { getPosts } from "@/lib/blog";
import { getLocale, useTranslations } from "@/i18n/utils";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const posts = await getPosts();
---

<Layout
  title={`${t("blog.title")} · Hamza Kargin`}
  description={t("blog.description")}
  image={ogImagePath("blog", locale)}
>
  <Section class="flex flex-col gap-3 py-16 md:py-24">
    <Breadcrumbs items={[{ label: t("blog.title") }]} />
    <h1 class="text-[40px] leading-[48px] font-[450] tracking-[-0.05em] md:text-5xl md:leading-[56px] md:tracking-[-0.06em]">{t("blog.title")}</h1>
    <p class="text-lg text-muted-foreground">{t("blog.description")}</p>
  </Section>
  <Section class="py-12 md:py-16">
    <PostList posts={posts} />
  </Section>
</Layout>
