---
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Section from "@/components/layout/Section.astro";
import Layout from "@/layouts/Layout.astro";
import { ogImagePath } from "@/lib/og";
import PostList from "@/components/blog/PostList.astro";
import { getPosts } from "@/lib/blog";
import { getLocale, useTranslations } from "@/i18n/utils";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const posts = await getPosts();
---

<Layout
  title={`${t("blog.title")} · Hamza Kargin`}
  description={t("blog.description")}
  image={ogImagePath("blog", locale)}
>
  <Section class="flex justify-center py-16 md:py-24">
    <div class="flex w-full max-w-3xl flex-col gap-3">
      <Breadcrumbs items={[{ label: t("blog.title") }]} />
      <h1 class="text-4xl font-extrabold tracking-[-0.04em] md:text-5xl">{t("blog.title")}</h1>
      <p class="text-lg text-muted-foreground">{t("blog.description")}</p>
    </div>
  </Section>
  <Section class="flex justify-center py-12 md:py-16">
    <div class="w-full max-w-3xl">
      <PostList posts={posts} />
    </div>
  </Section>
</Layout>
