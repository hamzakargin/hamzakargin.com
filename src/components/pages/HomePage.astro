---
import Contact from "@/components/home/Contact.astro";
import Education from "@/components/home/Education.astro";
import Experience from "@/components/home/Experience.astro";
import Recognition from "@/components/home/Recognition.astro";
import Hero from "@/components/home/Hero.astro";
import PersonSchema from "@/components/layout/PersonSchema.astro";
import WebSiteSchema from "@/components/layout/WebSiteSchema.astro";
import ShipLog from "@/components/home/ShipLog.astro";
import Stack from "@/components/home/Stack.astro";
import Writing from "@/components/home/Writing.astro";
import Work from "@/components/home/Work.astro";
import Layout from "@/layouts/Layout.astro";
import { ogImagePath } from "@/lib/og";
import { getLocale } from "@/i18n/utils";
---

<Layout image={ogImagePath("home", getLocale(Astro))}>
  <PersonSchema />
  <WebSiteSchema />
  <Hero />
  <ShipLog />
  <Work />
  <Writing />
  <Experience />
  <Education />
  <Stack />
  <Recognition />
  <Contact />
</Layout>
