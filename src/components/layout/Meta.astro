---
import { badgeVariants } from "@/components/ui/badge";

interface Props {
  badge?: string;
  items: (string | undefined)[];
}

const { badge, items } = Astro.props;
---

<p class="flex flex-wrap items-center gap-x-4 gap-y-1 overflow-hidden text-sm text-muted-foreground">
  {badge && <span class={badgeVariants({ variant: "secondary", className: "font-mono" })}>{badge}</span>}
  {
    items
      .filter(Boolean)
      .map((item, index) => (
        <span
          class:list={[
            (index > 0 || badge) &&
              "relative before:absolute before:top-1/2 before:-left-2 before:h-3 before:w-px before:-translate-y-1/2 before:bg-border",
          ]}
        >
          {item}
        </span>
      ))
  }
</p>
