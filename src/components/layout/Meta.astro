---
import { badgeVariants } from "@/components/ui/badge";

interface Props {
  badge?: string;
  items: (string | undefined)[];
}

const { badge, items } = Astro.props;
---

<p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
  {badge && <span class={badgeVariants({ variant: "secondary", className: "font-mono" })}>{badge}</span>}
  {
    items
      .filter(Boolean)
      .map((item, index) => (
        <>
          {(index > 0 || badge) && <span aria-hidden="true" class="h-3 w-px bg-border" />}
          <span>{item}</span>
        </>
      ))
  }
</p>
