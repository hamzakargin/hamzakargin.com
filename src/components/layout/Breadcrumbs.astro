---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import { cleanPath, getLocale, localizePath, useTranslations } from "@/i18n/utils";

interface Props {
  items: { label: string; href?: string }[];
}

const locale = getLocale(Astro);
const t = useTranslations(locale);
const items = [{ label: t("nav.home"), href: localizePath("/", locale) }, ...Astro.props.items];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: new URL(item.href ?? cleanPath(Astro.url), Astro.site).href,
  })),
};
---

<Breadcrumb data-pagefind-ignore>
  <BreadcrumbList>
    {
      items.map((item, index) => (
        <>
          {index > 0 && <BreadcrumbSeparator />}
          <BreadcrumbItem>
            {item.href ? (
              <BreadcrumbLink href={item.href}>{item.label}</BreadcrumbLink>
            ) : (
              <BreadcrumbPage className="line-clamp-1">{item.label}</BreadcrumbPage>
            )}
          </BreadcrumbItem>
        </>
      ))
    }
  </BreadcrumbList>
</Breadcrumb>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
