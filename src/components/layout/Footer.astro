---
import { Mail, Monitor, Moon, Sun } from "lucide-react";
import BrandIcon from "@/components/layout/BrandIcon.astro";
import { build } from "@/lib/build";
import { formatDate } from "@/lib/format";
import { languageNames, locales } from "@/i18n/ui";
import { cleanPath, getLocale, localizePath, stripLocale, useTranslations } from "@/i18n/utils";
import { site } from "@/lib/site";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const basePath = stripLocale(cleanPath(Astro.url)) || "/";
const themes = [
  { value: "system", label: t("theme.system"), icon: Monitor },
  { value: "light", label: t("theme.light"), icon: Sun },
  { value: "dark", label: t("theme.dark"), icon: Moon },
];
const links = [
  { href: localizePath("/about", locale), label: t("nav.about") },
  { href: localizePath("/#work", locale), label: t("nav.work") },
  { href: localizePath("/blog", locale), label: t("nav.writing") },
  { href: localizePath("/log", locale), label: t("nav.shipLog") },
  { href: localizePath("/#contact", locale), label: t("nav.contact") },
];
---

<footer class="px-4 md:px-6">
  <div class="mx-auto max-w-5xl border-x border-border text-sm">
    <dl class="grid grid-cols-2 md:grid-cols-4 [&>div]:border-b [&>div]:border-border [&>div]:px-6 [&>div]:py-4 md:[&>div]:px-10">
      <div class="border-r border-border">
        <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{t("footer.deployedOn")}</dt>
        <dd class="mt-1.5">{t("footer.deployedValue")}</dd>
      </div>
      <div class="md:border-r md:border-border">
        <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{t("footer.source")}</dt>
        <dd class="mt-1.5">
          <a href={site.repo} class="underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground">hamzakargin.com</a>
        </dd>
      </div>
      <div class="border-r border-border">
        <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{t("footer.license")}</dt>
        <dd class="mt-1.5">
          <a href={`${site.repo}/blob/main/LICENSE`} class="underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground">MIT</a>
        </dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{t("footer.typeface")}</dt>
        <dd class="mt-1.5">Geist</dd>
      </div>
      <div class="col-span-2 md:border-r md:border-border">
        <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{t("footer.builtWith")}</dt>
        <dd class="mt-1.5 flex flex-col gap-0.5 font-mono text-[13px]">
          {build.stack.map((item) => <span>{item}</span>)}
        </dd>
      </div>
      <div class="col-span-2">
        <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{t("footer.lastDeployed")}</dt>
        <dd class="mt-1.5 flex flex-col gap-0.5">
          <time datetime={build.date.toISOString()}>{formatDate(build.date, locale)}</time>
          {
            build.commit && (
              <a href={`${site.repo}/commit/${build.commit}`} class="w-fit font-mono text-[13px] text-muted-foreground transition-colors hover:text-foreground">
                {build.commit}
              </a>
            )
          }
        </dd>
      </div>
    </dl>
    <div class="flex flex-col gap-4 px-6 py-6 text-muted-foreground md:flex-row md:items-center md:justify-between md:px-10">
      <div class="flex flex-col gap-2">
        <p>© {build.date.getFullYear()} {site.name}</p>
        <nav aria-label={t("language.label")} class="flex flex-wrap gap-x-3 gap-y-1 text-xs">
          {
            locales.map((code) => (
              <a
                href={localizePath(basePath, code)}
                hreflang={code}
                lang={code}
                aria-current={code === locale ? "true" : undefined}
                class="transition-colors hover:text-foreground aria-[current]:text-foreground"
              >
                {languageNames[code]}
              </a>
            ))
          }
        </nav>
      </div>
      <nav aria-label={t("footer.label")} class="flex flex-wrap gap-x-5 gap-y-2">
        {
          links.map(({ href, label }) => (
            <a href={href} class="transition-colors hover:text-foreground">
              {label}
            </a>
          ))
        }
      </nav>
      <div class="flex items-center gap-4">
        <div
          role="radiogroup"
          aria-label={t("a11y.toggleTheme")}
          class="flex items-center gap-0.5 rounded-full border border-border p-0.5"
        >
          {
            themes.map(({ value, label, icon: Icon }) => (
              <button
                type="button"
                role="radio"
                aria-checked="false"
                aria-label={label}
                title={label}
                data-theme-option={value}
                class="flex size-6 items-center justify-center rounded-full transition-colors hover:text-foreground aria-checked:bg-muted aria-checked:text-foreground"
              >
                <Icon className="size-3.5" />
              </button>
            ))
          }
        </div>
        <a href={site.github} aria-label="GitHub" class="transition-colors hover:text-foreground">
          <BrandIcon name="GitHub" class="size-4" />
        </a>
        <a href={site.linkedin} aria-label="LinkedIn" class="transition-colors hover:text-foreground">
          <BrandIcon name="LinkedIn" class="size-4" />
        </a>
        <a href={`mailto:${site.email}`} aria-label="Email" class="transition-colors hover:text-foreground">
          <Mail className="size-4" />
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const options = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-option]")];

  function read() {
    try {
      return localStorage.getItem("theme") ?? "system";
    } catch {
      return "system";
    }
  }

  function apply(theme: string) {
    const dark = theme === "dark" || (theme === "system" && media.matches);
    document.documentElement.classList.toggle("dark", dark);
    for (const option of options) {
      option.setAttribute("aria-checked", String(option.dataset.themeOption === theme));
    }
  }

  for (const option of options) {
    option.addEventListener("click", () => {
      const theme = option.dataset.themeOption ?? "system";
      try {
        if (theme === "system") localStorage.removeItem("theme");
        else localStorage.setItem("theme", theme);
      } catch {}
      apply(theme);
    });
  }
  media.addEventListener("change", () => {
    if (read() === "system") apply("system");
  });
  apply(read());
</script>
