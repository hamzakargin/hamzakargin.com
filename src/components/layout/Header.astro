---
import { Search } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { cleanPath, getLocale, localizePath, useTranslations } from "@/i18n/utils";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const currentPath = cleanPath(Astro.url);
const links = [
  { href: localizePath("/#work", locale), label: t("nav.work") },
  { href: localizePath("/about", locale), label: t("nav.about") },
  { href: localizePath("/blog", locale), label: t("nav.writing") },
  { href: localizePath("/log", locale), label: t("nav.log") },
];
const kbd =
  "flex h-5 min-w-5 items-center justify-center rounded border border-border bg-muted px-1 font-sans text-[11px] leading-none";
---

<header
  class="group/header sticky top-0 z-20 border-b border-border bg-background/80 px-4 backdrop-blur md:px-6"
  data-header
>
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between border-x border-border px-6 md:px-10">
    <a href={localizePath("/", locale)} class="flex items-center">
      <img src="/favicon.svg" alt="Hamza Kargin" width="28" height="28" class="size-7" />
    </a>
    <nav class="flex items-center gap-1 max-md:hidden">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              buttonVariants({ variant: "ghost", size: "sm" }),
              currentPath.startsWith(href) ? "text-foreground" : "text-muted-foreground",
            ]}
          >
            {label}
          </a>
        ))
      }
      <span aria-hidden="true" class="mx-2 h-4 w-px bg-border"></span>
      <button
        type="button"
        aria-label={t("search.label")}
        title={t("search.label")}
        class="flex h-8 items-center gap-1.5 rounded-md px-2 text-muted-foreground transition-colors hover:text-foreground"
        data-command-open
      >
        <Search className="size-4" aria-hidden="true" />
        <kbd class={kbd} data-command-mod>⌘</kbd>
        <kbd class={kbd}>K</kbd>
      </button>
    </nav>
    <div class="flex items-center gap-1 md:hidden">
      <button
        type="button"
        aria-label={t("search.label")}
        class="flex size-9 items-center justify-center rounded-md text-foreground"
        data-command-open
      >
        <Search className="size-4" aria-hidden="true" />
      </button>
    <button
      type="button"
      aria-label={t("a11y.menu")}
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="-mr-2 flex size-9 items-center justify-center rounded-md"
      data-menu-toggle
    >
      <span class="relative h-3 w-4">
        <span
          class="absolute top-[5px] left-0 h-[1.5px] w-4 -translate-y-[3px] bg-foreground transition-transform duration-200 group-data-open/header:translate-y-0 group-data-open/header:rotate-45"
        ></span>
        <span
          class="absolute top-[5px] left-0 h-[1.5px] w-4 translate-y-[3px] bg-foreground transition-transform duration-200 group-data-open/header:translate-y-0 group-data-open/header:-rotate-45"
        ></span>
      </span>
    </button>
    </div>
  </div>
</header>
<nav
  id="mobile-menu"
  class="group/menu invisible fixed inset-x-0 top-14 bottom-0 z-20 bg-background/60 touch-none opacity-0 backdrop-blur-sm transition-[opacity,visibility] duration-200 data-open:visible data-open:opacity-100 md:hidden"
  data-menu-backdrop
>
  <div class="border-b border-border bg-background px-4">
    <ul
      class="mx-auto flex max-w-5xl -translate-y-2 flex-col border-x border-border px-6 py-3 transition-transform duration-200 group-data-open/menu:translate-y-0"
    >
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                "flex h-11 items-center text-base transition-colors hover:text-foreground",
                currentPath.startsWith(href) ? "text-foreground" : "text-muted-foreground",
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu-backdrop]");

  const setOpen = (open: boolean) => {
    header?.toggleAttribute("data-open", open);
    menu?.toggleAttribute("data-open", open);
    document.documentElement.style.overflow = open ? "hidden" : "";
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
  for (const link of document.querySelectorAll("#mobile-menu a")) {
    link.addEventListener("click", () => setOpen(false));
  }
  menu?.addEventListener("click", (event) => {
    if (event.target === event.currentTarget) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
  matchMedia("(min-width: 48rem)").addEventListener("change", () => setOpen(false));
</script>
