---
import { Menu, Moon, Sun } from "lucide-react";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import { buttonVariants } from "@/components/ui/button";
import { cleanPath, getLocale, localizePath, useTranslations } from "@/i18n/utils";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const currentPath = cleanPath(Astro.url);
const links = [
  { href: localizePath("/#work", locale), label: t("nav.work") },
  { href: localizePath("/about", locale), label: t("nav.about") },
  { href: localizePath("/blog", locale), label: t("nav.writing") },
  { href: localizePath("/log", locale), label: t("nav.log") },
];
---

<header class="sticky top-0 z-20 border-b border-border bg-background/80 px-4 backdrop-blur md:px-6">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between border-x border-border px-6 md:px-10">
    <a href={localizePath("/", locale)} class="font-medium tracking-tight whitespace-nowrap">Hamza Kargin</a>
    <nav class="flex items-center gap-1">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              buttonVariants({ variant: "ghost", size: "sm" }),
              "max-md:hidden",
              currentPath.startsWith(href) ? "text-foreground" : "text-muted-foreground",
            ]}
          >
            {label}
          </a>
        ))
      }
      <LanguageSwitcher />
      <details class="group relative md:hidden" data-dropdown>
        <summary
          aria-label={t("a11y.menu")}
          class={buttonVariants({
            variant: "ghost",
            size: "icon-sm",
            className: "list-none [&::-webkit-details-marker]:hidden",
          })}
        >
          <Menu />
        </summary>
        <ul class="absolute top-full right-0 z-30 mt-2 flex w-44 flex-col rounded-lg border border-border bg-popover p-1 text-sm shadow-lg">
          {
            links.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    "block rounded-md px-2.5 py-2 transition-colors hover:bg-muted hover:text-foreground",
                    currentPath.startsWith(href) ? "text-foreground" : "text-muted-foreground",
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <button
        id="theme-toggle"
        type="button"
        aria-label={t("a11y.toggleTheme")}
        class={buttonVariants({ variant: "ghost", size: "icon-sm" })}
      >
        <Sun className="hidden dark:block" />
        <Moon className="dark:hidden" />
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  });
</script>
