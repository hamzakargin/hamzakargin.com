---
interface Props {
  title: string;
  count?: number;
}

const { title, count } = Astro.props;
---

<h2 class="text-center text-2xl font-semibold tracking-tight text-balance md:text-3xl">
  {title}
  {count !== undefined && <sup class="ml-0.5 font-mono text-sm font-normal text-muted-foreground">({count})</sup>}
</h2>
