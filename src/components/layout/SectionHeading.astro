---
interface Props {
  title: string;
  count?: number;
}

const { title, count } = Astro.props;
---

<h2 class="text-center text-[28px] leading-[1.2] font-[450] tracking-[-0.04em] text-balance md:text-[32px] md:leading-10">
  {title}
  {count !== undefined && <sup class="ml-0.5 font-mono text-sm font-normal text-muted-foreground">({count})</sup>}
</h2>
