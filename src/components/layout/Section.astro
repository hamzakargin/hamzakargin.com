---
import { Plus } from "lucide-react";

interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section id={id} class="relative border-b border-border">
  <div class:list={["px-6 md:px-10", className]}>
    <slot />
  </div>
  <Plus
    aria-hidden="true"
    strokeWidth={1}
    className="absolute -bottom-2 -left-2 z-10 size-4 text-muted-foreground"
  />
  <Plus
    aria-hidden="true"
    strokeWidth={1}
    className="absolute -right-2 -bottom-2 z-10 size-4 text-muted-foreground"
  />
</section>
