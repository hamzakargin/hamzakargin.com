---
import { getLocale, pick, useTranslations } from "@/i18n/utils";
import { getCollection } from "astro:content";
import { GraduationCap } from "lucide-react";
import Section from "@/components/layout/Section.astro";
import SectionHeading from "@/components/layout/SectionHeading.astro";
import TimelineItem from "@/components/layout/TimelineItem.astro";
import { formatRange } from "@/lib/format";

const education = (await getCollection("education")).toSorted(
  (a, b) => b.data.start.valueOf() - a.data.start.valueOf(),
);
const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<Section id="education" class="flex flex-col items-center gap-10 py-16 md:py-24">
  <SectionHeading title={t("section.education")} />
  <ul class="flex w-full max-w-3xl flex-col divide-y divide-border border-y border-border">
    {
      education.map(({ data }) => (
        <li class="py-5">
          <TimelineItem
            icon={GraduationCap}
            title={pick(data.school, locale)}
            meta={[formatRange(data.start, data.end), pick(data.degree, locale), pick(data.field, locale)]}
            skills={data.skills}
          />
        </li>
      ))
    }
  </ul>
</Section>
