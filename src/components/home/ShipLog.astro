---
import { ArrowRight } from "lucide-react";
import Section from "@/components/layout/Section.astro";
import SectionHeading from "@/components/layout/SectionHeading.astro";
import LogList from "@/components/log/LogList.astro";
import { buttonVariants } from "@/components/ui/button";
import { getLogEntries } from "@/lib/log";

const entries = (await getLogEntries()).slice(0, 6);
---

<Section id="log" class="flex flex-col items-center gap-10 py-16 md:py-24">
  <SectionHeading title="Ship log" description="What I’ve shipped, by date." />
  <div class="w-full max-w-3xl">
    <LogList entries={entries} />
  </div>
  <a href="/log" class={buttonVariants({ variant: "outline", size: "sm" })}>
    Full log <ArrowRight data-icon="inline-end" />
  </a>
</Section>
