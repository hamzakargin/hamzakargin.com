---
import { getLocale, localizePath, useTranslations } from "@/i18n/utils";
import { ArrowRight } from "lucide-react";
import Section from "@/components/layout/Section.astro";
import SectionHeading from "@/components/layout/SectionHeading.astro";
import LogList from "@/components/log/LogList.astro";
import { buttonVariants } from "@/components/ui/button";
import { getLogEntries } from "@/lib/log";

const allEntries = await getLogEntries();
const total = allEntries.length;
const entries = allEntries.slice(0, 6);
const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<Section id="log" class="flex flex-col items-center gap-10 py-16 md:py-24">
  <SectionHeading title={t("section.shipLog")} count={total} />
  <div class="w-full max-w-3xl">
    <LogList entries={entries} />
  </div>
  <a href={localizePath("/log", locale)} class={buttonVariants({ variant: "outline", size: "sm" })}>
    {t("shipLog.full")} <ArrowRight data-icon="inline-end" />
  </a>
</Section>
