---
import { getLocale, pick, useTranslations } from "@/i18n/utils";
import { ArrowUpRight } from "lucide-react";
import Section from "@/components/layout/Section.astro";
import SectionHeading from "@/components/layout/SectionHeading.astro";
import { getFeaturedProjects } from "@/lib/projects";
import { Card, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";

const projects = await getFeaturedProjects();
const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<Section id="work" class="flex flex-col items-center gap-10 py-16 md:py-24">
  <SectionHeading title={t("section.work")} count={projects.length} />
  <ul class="grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map(({ data: project }) => {
        const link = project.homepage ?? project.github;
        const Wrapper = link ? "a" : "div";
        return (
          <li>
            <Wrapper href={link} class="group block h-full rounded-(--radius-4xl) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
              <Card size="sm" className="h-full transition-shadow group-hover:shadow-lg">
                <CardHeader>
                  <CardTitle>{project.name}</CardTitle>
                  <CardDescription>{pick(project.description, locale)}</CardDescription>
                </CardHeader>
                <CardFooter className="mt-auto justify-between text-muted-foreground">
                  <span class="text-xs tabular-nums">{project.dateCreated.getUTCFullYear()}</span>
                  {link && (
                    <ArrowUpRight className="size-4 motion-safe:transition-transform motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:translate-x-0.5" />
                  )}
                </CardFooter>
              </Card>
            </Wrapper>
          </li>
        );
      })
    }
  </ul>
</Section>
