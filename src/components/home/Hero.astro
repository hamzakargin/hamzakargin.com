---
import { getLocale, useTranslations } from "@/i18n/utils";
import { ArrowUpRight } from "lucide-react";
import { site } from "@/lib/site";
import Section from "@/components/layout/Section.astro";
import { buttonVariants } from "@/components/ui/button";

const t = useTranslations(getLocale(Astro));
---

<Section class="relative isolate flex flex-col items-center gap-6 py-20 text-center md:py-32">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(ellipse_at_top,var(--color-muted),transparent_70%)]"
  >
  </div>
  <h1 class="text-5xl font-extrabold tracking-[-0.06em] text-balance md:text-7xl">Hamza Kargin</h1>
  <p class="max-w-xl text-lg text-pretty text-muted-foreground md:text-xl">
    <span class="font-medium text-foreground">{t("hero.role")}</span> {t("hero.leadBefore")}{" "}
    <span class="font-medium text-foreground">{t("hero.leadHighlight")}</span>{" "}
    {t("hero.leadAfter")}
  </p>
  <div class="flex gap-3 pt-2">
    <a class={buttonVariants()} href={site.github}>
      GitHub <ArrowUpRight data-icon="inline-end" />
    </a>
    <a class={buttonVariants({ variant: "outline" })} href={site.linkedin}>
      LinkedIn <ArrowUpRight data-icon="inline-end" />
    </a>
  </div>
</Section>
