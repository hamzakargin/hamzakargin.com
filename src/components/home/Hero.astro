---
import { ArrowUpRight } from "lucide-react";
import { site } from "@/lib/site";
import Section from "@/components/layout/Section.astro";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
---

<Section class="relative isolate flex flex-col items-center gap-6 py-20 text-center md:py-32">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(ellipse_at_top,var(--color-muted),transparent_70%)]"
  >
  </div>
  <a href="#contact" class={badgeVariants({ variant: "outline" })}>
    <span class="size-1.5 rounded-full bg-emerald-500"></span>
    Open to work
  </a>
  <h1 class="text-5xl font-extrabold tracking-[-0.06em] text-balance md:text-7xl">Hamza Kargin</h1>
  <p class="max-w-xl text-lg text-pretty text-muted-foreground md:text-xl">
    <span class="font-medium text-foreground">JavaScript Software Engineer</span> based in Antalya,
    Turkey. I build <span class="font-medium text-foreground">web applications</span> and the systems
    behind them.
  </p>
  <div class="flex gap-3 pt-2">
    <a class={buttonVariants()} href="#contact">Get in touch</a>
    <a class={buttonVariants({ variant: "outline" })} href={site.github}>
      GitHub <ArrowUpRight data-icon="inline-end" />
    </a>
    <a class={buttonVariants({ variant: "outline" })} href={site.linkedin}>
      LinkedIn <ArrowUpRight data-icon="inline-end" />
    </a>
  </div>
</Section>
