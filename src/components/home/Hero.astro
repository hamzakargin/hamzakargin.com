---
import { getLocale, useTranslations } from "@/i18n/utils";
import { ArrowUpRight } from "lucide-react";
import { site } from "@/lib/site";
import Section from "@/components/layout/Section.astro";
import { buttonVariants } from "@/components/ui/button";

const t = useTranslations(getLocale(Astro));
---

<Section class="flex flex-col items-center gap-6 py-16 text-center md:py-24">
  <svg
    aria-hidden="true"
    viewBox="4.5 4 54 54"
    class="-mb-10 h-40 w-auto [mask-image:linear-gradient(to_bottom,black_35%,transparent_95%)] md:-mb-14 md:h-56"
  >
    <defs>
      <linearGradient id="hero-h" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fb923c"></stop>
        <stop offset="1" stop-color="#e11d48"></stop>
      </linearGradient>
    </defs>
    <path
      d="M11 46C19 40 29 27 32 17C34.5 9 30 4.5 26.5 9.5C22.5 15 21 36 19.5 53C22 43 27.5 34.5 34 34.5C39.5 34.5 40.5 39 39 44.5C37.5 50 39 54 43.5 53C47 52.2 50 49 53 45"
      fill="none"
      stroke="url(#hero-h)"
      stroke-width="6.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <path
      d="M11 46C19 40 29 27 32 17C34.5 9 30 4.5 26.5 9.5C22.5 15 21 36 19.5 53C22 43 27.5 34.5 34 34.5C39.5 34.5 40.5 39 39 44.5C37.5 50 39 54 43.5 53C47 52.2 50 49 53 45"
      fill="none"
      stroke="var(--background)"
      stroke-width="5.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <h1 class="text-[40px] leading-[48px] font-[450] tracking-[-0.05em] text-balance md:text-[64px] md:leading-none md:tracking-[-0.06em]">Hamza Kargin</h1>
  <p class="max-w-[648px] text-lg leading-7 text-balance text-foreground/75">
    <span class="font-[550] text-foreground">{t("hero.role")}</span> {t("hero.leadBefore")}{" "}
    <span class="font-[550] whitespace-nowrap text-foreground">{t("hero.leadHighlight")}</span>{" "}
    {t("hero.leadAfter")}
  </p>
  <div class="flex gap-3 pt-4">
    <a class={buttonVariants()} href={site.github}>
      GitHub <ArrowUpRight data-icon="inline-end" />
    </a>
    <a class={buttonVariants({ variant: "outline" })} href={site.linkedin}>
      LinkedIn <ArrowUpRight data-icon="inline-end" />
    </a>
  </div>
</Section>
