---
interface Props {
  headers: string[];
  rows: string[][];
}

const { headers, rows } = Astro.props;
---

<div class="not-prose my-6 overflow-x-auto rounded-lg border border-border">
  <table class="w-full text-left text-sm">
    <thead class="bg-muted/50">
      <tr>
        {headers.map((header) => <th class="px-4 py-2.5 font-medium">{header}</th>)}
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) => (
              <td class="px-4 py-2.5 text-muted-foreground">{cell}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
