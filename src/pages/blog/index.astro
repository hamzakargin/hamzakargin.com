---
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Section from "@/components/layout/Section.astro";
import Layout from "@/layouts/Layout.astro";
import PostList from "@/components/blog/PostList.astro";
import { getPosts } from "@/lib/blog";

const posts = await getPosts();
---

<Layout title="Writing · Hamza Kargin" description="Notes on the things I build and the tools I use.">
  <Section class="flex flex-col items-center gap-3 py-16 text-center md:py-24">
    <Breadcrumbs items={[{ label: "Writing" }]} />
    <h1 class="text-4xl font-extrabold tracking-[-0.04em] md:text-5xl">Writing</h1>
    <p class="text-lg text-muted-foreground">Notes on the things I build and the tools I use.</p>
  </Section>
  <Section class="flex justify-center py-12 md:py-16">
    <div class="w-full max-w-3xl">
      <PostList posts={posts} />
    </div>
  </Section>
</Layout>
