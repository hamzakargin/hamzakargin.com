---
import { ArrowUpRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-6 px-6">
    <p class="text-sm text-muted-foreground">JavaScript Software Engineer</p>
    <h1 class="text-4xl font-semibold tracking-tight md:text-6xl">Hamza Kargin</h1>
    <p class="max-w-xl text-muted-foreground">
      Building and running real products, from database to deploy.
    </p>
    <div class="flex gap-3">
      <a class={buttonVariants()} href="https://github.com/hamzakargin">
        GitHub <ArrowUpRight />
      </a>
      <a class={buttonVariants({ variant: "outline" })} href="https://www.linkedin.com/in/hamzakargin">
        LinkedIn <ArrowUpRight />
      </a>
    </div>
  </main>
</Layout>
